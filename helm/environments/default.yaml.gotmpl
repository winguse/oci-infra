coderDomain: coder.i.wingu.se
tls:
  commonWildcardDomain: "*.i.wingu.se"
  commonSecretName: common-tls
  coderWildcardDomain: "*.coder.i.wingu.se"
  coderSecretName: coder-tls
acmeEmail: "certs@winguse.com"
acmeServer: https://acme-v02.api.letsencrypt.org/directory
clusterAutoscaler:
  nodePoolId: "ocid1.nodepool.oc1.us-sanjose-1.aaaaaaaa4vig3xtblub4u2d4efnexwtcyruuizx2di4k5b2srnmcapzfm6ea"

postgresql:
  namespace: "postgres"
  auth:
    username: "coder"
    password: {{ env "POSTGRES_PASSWORD" | default "coder" | quote }}
    database: "coder"
  extraDatabases:
    - name: "litellm"
      username: "litellm"
      password: {{ env "LITELLM_DB_PASSWORD" | default "litellm-pass" | quote }}

acmeDNS:
  host: "https://challenge.winguse.workers.dev"
  secretName: acme-dns
  secretKey: acmedns.json

coder:
  oidc:
    issuerUrl: "https://auth.wingu.se"
    clientId: "oc-coder"
    clientSecret: {{ env "CODER_OIDC_CLIENT_SECRET" | default "" | quote }}
    emailDomain: "me.com"
    ignoreEmailVerified: false
    disablePasswordAuth: false
  telemetry:
    enable: false

cloudflare:
  tunnelToken: {{ env "CLOUDFLARE_TUNNEL_TOKEN" | default "" | quote }}
  coderDomain: "coder.wingu.se"
  coderWildcardDomain: "*.coder.wingu.se"

microNfs:
  backingStorage:
    size: "100Gi"
    storageClassName: "oci-bv"
    volumeName: "micro-nfs-backing"
    volumeHandle: "ocid1.volume.oc1.us-sanjose-1.abzwuljrio4pqs65jiqlyckxt5ja4lhhfaecwiukbdmfuuinrgw567er753q"
    nodeAffinity:
      required:
        nodeSelectorTerms:
          - matchExpressions:
              - key: topology.kubernetes.io/zone
                operator: In
                values:
                  - "US-SANJOSE-1-AD-1"
  storageClass:
    name: "micro-nfs"
    isDefault: true
  resources:
    limits:
      memory: "521Mi"
    requests:
      cpu: "50m"
      memory: "256Mi"

hermes:
  domain: "hm.i.wingu.se"
  codeServerDomain: "hmc.i.wingu.se"
  mtls:
    enabled: true
  dashboard:
    enabled: true
    publicUrl: "https://hm.i.wingu.se"
    oidc:
      issuer: "https://auth.wingu.se"
      clientId: "hermes-dashboard"
      scopes: "openid profile email"
  apiServer:
    enabled: true
  codeServer:
    enabled: true
  networkPolicy:
    enabled: true

openclaw:
  domain: "oc.i.wingu.se"
  replicaCount: 0
  mtls:
    enabled: true

litellm:
  domain: "llm.i.wingu.se"
  masterKey: {{ env "LITELLM_MASTER_KEY" | default "sk-litellm-master-key-12345" | quote }}
  replicaCount: 0
  database:
    username: "litellm"
    password: {{ env "LITELLM_DB_PASSWORD" | default "litellm-pass" | quote }}
    name: "litellm"
  oidc:
    enabled: true
    clientId: "litellm"
    clientSecret: {{ env "LITELLM_OIDC_CLIENT_SECRET" | default "" | quote }}
    authEndpoint: "https://auth.wingu.se/api/oidc/authorization"
    tokenEndpoint: "https://auth.wingu.se/api/oidc/token"
    userEndpoint: "https://auth.wingu.se/api/oidc/userinfo"

bifrost:
  domain: "bf.i.wingu.se"
  publicDomain: "gwl.i.wingu.se"
  replicaCount: 0
  mtls:
    enabled: true

presidio:
  namespace: "presidio"
  analyzer:
    replicaCount: 0
  anonymizer:
    replicaCount: 0

valkey:
  namespace: "valkey"
  replicaCount: 1

omniroute:
  namespace: "omniroute"
  domain: "omni.i.wingu.se"
  apiDomain: "omni-api.i.wingu.se"
  replicaCount: 1
  mtlsEnabled: true
  networkPolicy:
    enabled: true
  requireApiKey: "true"

fas:
  namespace: "fas"
  domain: "a.i.wingu.se"
  replicaCount: 1
  mtls:
    enabled: true
  networkPolicy:
    enabled: true

browser:
  namespace: "browser"
  domain: "s.i.wingu.se"
  replicaCount: 1
  fas:
    namespace: "fas"
    middlewareName: "fas-auth"
  networkPolicy:
    enabled: true
